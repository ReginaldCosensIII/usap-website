<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository-level NuGet configuration.

  Purpose: Clears the stale machine-level fallback package folder entry
  (D:\VS2022\shared\NuGetPackages) that was written by a Visual Studio
  installation that is no longer present at that path. Without this override,
  dotnet build fails with:
      NuGet.Packaging.Core.PackagingException: Unable to find fallback
      package folder 'D:\VS2022\shared\NuGetPackages'.

  This file does not add or remove package sources; it only suppresses the
  broken fallback reference at the repository scope.
-->
<configuration>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
