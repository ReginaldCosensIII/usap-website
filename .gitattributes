# =============================================================================
# USAP Website — .gitattributes
# Ensures consistent line endings and correct binary handling across platforms.
# =============================================================================

# Default: normalize text files to LF in the repository
* text=auto eol=lf

# Windows-specific scripts — keep CRLF on checkout for Windows shells
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Source code and markup — always LF
*.cs     text eol=lf diff=csharp
*.cshtml text eol=lf
*.razor  text eol=lf
*.csproj text eol=lf
*.sln    text eol=lf
*.json   text eol=lf
*.jsonc  text eol=lf
*.xml    text eol=lf
*.config text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
*.html   text eol=lf
*.htm    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf

# SVG — text with LF; diffable
*.svg    text eol=lf diff

# Binary files — do not diff or mangle
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
*.pdf    binary
*.xlsx   binary
*.xls    binary
*.zip    binary
*.pfx    binary
*.p12    binary
*.pem    binary
*.key    binary
*.crt    binary
*.cer    binary
