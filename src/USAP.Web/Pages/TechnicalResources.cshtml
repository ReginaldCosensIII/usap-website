@page "/technical-resources"
@model USAP.Web.Pages.TechnicalResourcesModel
@{
    ViewData[USAP.Web.Models.SeoMetadata.ViewDataKey] = new USAP.Web.Models.SeoMetadata
    {
        Title = "Technical Resources",
        Description = "Access available product datasheets and technical documentation for USAP antenna systems, rotators, and accessories.",
        CanonicalPath = "/technical-resources",
        Robots = "index, follow",
        OpenGraphType = "website"
    };

}

@section Styles {
    <link rel="stylesheet" href="~/css/technical-resources.css" asp-append-version="true" />
}

<!-- Section 1: Hero / Introductory Banner -->
<section class="internal-hero internal-hero--technical-resources" aria-labelledby="technical-resources-heading">
    <div class="internal-hero-bg" aria-hidden="true"></div>
    <img class="internal-hero-image"
         src="~/images/technical-resources/usap-technical-resources-hero-requirements-document-candidate-b-v1.png"
         alt=""
         width="2048"
         height="768"
         fetchpriority="high"
         decoding="async" />
    <div class="internal-hero-overlay" aria-hidden="true"></div>
    <div class="container">
        <div class="internal-hero-content">
            <span class="eyebrow internal-hero-eyebrow">Documentation Library</span>
            <h1 id="technical-resources-heading" class="internal-hero-title">Technical Resources</h1>
            <p class="internal-hero-lead">Access official data sheets, system overviews, and technical specifications for USAP antenna systems, positioning rotators, and tower accessories.</p>
        </div>
    </div>
</section>

<!-- Section 2: Technical Resources Library -->
<section class="section technical-resources-section" aria-label="Technical documents library">
    <div class="container">
        <!-- Toolbar: Search and Family Filter Controls -->
        <div class="resources-toolbar" role="search" aria-label="Search and filter technical resources">
            <div class="resources-toolbar__row">
                <div class="resources-toolbar__context">
                    <span class="resources-toolbar__heading">Browse Technical Documents</span>
                </div>
                <form method="get" action="/technical-resources" class="resources-search-form" id="tech-search-form">
                    <div class="resources-search-wrapper">
                        <label for="tech-search-input" class="sr-only">Search technical documents by model, keyword, or title</label>
                        <svg class="search-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="search"
                               id="tech-search-input"
                               name="q"
                               value="@Model.Q"
                               class="resources-search-input"
                               placeholder="Search by model, title, or keyword (e.g. LP-1017, discone, rotator)..."
                               autocomplete="off"
                               aria-describedby="search-live-status" />
                        <button type="button" id="clear-search-btn" class="resources-search-clear" aria-label="Clear search input" hidden>
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>
                    <button type="submit" class="btn btn-secondary resources-search-submit">Search</button>
                </form>
            </div>

            <div class="resources-filter-bar" role="group" aria-label="Filter documents by product family">
                @foreach (var cat in Model.Categories)
                {
                    var isSelected = string.Equals(Model.ActiveFamily, cat.Slug, StringComparison.OrdinalIgnoreCase);
                    <button type="button"
                            class="filter-pill @(isSelected ? "filter-pill--active" : "")"
                            data-family="@cat.Slug"
                            aria-pressed="@(isSelected ? "true" : "false")">
                        <span class="filter-pill__label">@cat.Name</span>
                        <span class="filter-pill__count">@cat.Count</span>
                    </button>
                }
            </div>
        </div>

        <!-- Active Preset Filter Banner (e.g. Data Sheets or Antenna Systems) -->
        <div class="active-filter-banner @(string.IsNullOrWhiteSpace(Model.ActiveFilterLabel) ? "active-filter-banner--hidden" : "")" id="active-filter-banner">
            <span class="active-filter-text">Filtered by: <strong id="active-filter-label">@(Model.ActiveFilterLabel ?? "")</strong></span>
            <a href="/technical-resources" class="active-filter-clear" id="active-filter-clear-btn" aria-label="Clear active filter">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
                Clear filter
            </a>
        </div>

        <!-- Live Status and Results Count -->
        <div id="search-live-status" class="sr-only" aria-live="polite" aria-atomic="true">
            Showing @Model.FilteredDocuments.Count of @Model.TotalDocumentCount technical documents
        </div>

        <div class="resources-status-bar">
            <span class="resources-count" id="resources-count-display">
                Showing <strong id="visible-count">@Model.FilteredDocuments.Count</strong> of @Model.TotalDocumentCount technical documents
            </span>
            <button type="button" id="toolbar-reset-btn" class="btn-text resources-reset-link" hidden>
                Reset filters
            </button>
        </div>

        <!-- Grouped Family Sections Directory (Variant C) -->
        <div class="resources-directory" id="resources-directory">
            @foreach (var group in Model.FamilyGroups)
            {
                var isGroupVisible = group.MatchingCount > 0;

                <section class="resource-family @(!isGroupVisible ? "resource-family--hidden" : "")"
                         id="family-@group.Slug"
                         data-family="@group.Slug"
                         aria-labelledby="family-heading-@group.Slug">
                    <header class="resource-family__header">
                        <div class="resource-family__title-wrapper">
                            <span class="resource-family__accent-bar" aria-hidden="true"></span>
                            <h2 id="family-heading-@group.Slug" class="resource-family__title">@group.Name</h2>
                        </div>
                        <div class="resource-family__meta">
                            <span class="resource-family__count">
                                <span class="family-visible-count">@group.MatchingCount</span>
                                <span class="family-count-label">@(group.MatchingCount == 1 ? "DOCUMENT" : "DOCUMENTS")</span>
                            </span>
                        </div>
                    </header>

                    <div class="resource-family__documents" role="list">
                        @foreach (var doc in group.Documents)
                        {
                            var isInitiallyVisible = Model.FilteredDocuments.Any(f => f.Id == doc.Id);
                            var isAntennaFamily = doc.FamilySlug == "log-periodic-antennas" ||
                                                  doc.FamilySlug == "portable-transportable-antennas" ||
                                                  doc.FamilySlug == "aperiodic-loop-antennas" ||
                                                  doc.FamilySlug == "nvis-antennas";

                            <article class="resource-document-row @(!isInitiallyVisible ? "resource-document-row--hidden" : "")"
                                     role="listitem"
                                     data-id="@doc.Id"
                                     data-slug="@doc.Slug"
                                     data-family="@doc.FamilySlug"
                                     data-type="@(string.Equals(doc.DocumentType, "Data sheet", StringComparison.OrdinalIgnoreCase) ? "data-sheet" : "other")"
                                     data-is-antenna="@(isAntennaFamily ? "true" : "false")"
                                     data-search="@doc.SearchText.ToLowerInvariant()"
                                     data-title="@doc.Title.ToLowerInvariant()"
                                     data-models="@string.Join(" ", doc.ModelCodes).ToLowerInvariant()">
                                @{
                                    var thumbnail = Model.GetDocumentThumbnail(doc);
                                }
                                @if (thumbnail != null)
                                {
                                    <div class="resource-document-row__thumbnail">
                                        <img src="@thumbnail.ImagePath"
                                             alt="@thumbnail.AltText"
                                             width="96"
                                             height="64"
                                             loading="lazy"
                                             class="resource-document-row__thumb-img" />
                                    </div>
                                }
                                <div class="resource-document-row__main">
                                    <div class="resource-document-row__header-line">
                                        <h3 class="resource-document-row__title">
                                            <a href="@doc.DetailUrl" class="resource-document-row__title-link">@doc.Title</a>
                                        </h3>
                                        <span class="resource-document-row__type-badge">@doc.DocumentType</span>
                                    </div>

                                    @if (doc.ModelCodes.Count > 0)
                                    {
                                        <div class="resource-document-row__models" aria-label="Covered models">
                                            <span class="resource-document-row__models-label">Covered Models:</span>
                                            <ul class="resource-document-row__model-tags" role="list">
                                                @foreach (var modelCode in doc.ModelCodes)
                                                {
                                                    <li class="resource-document-row__model-tag"><code>@modelCode</code></li>
                                                }
                                            </ul>
                                        </div>
                                    }

                                    <p class="resource-document-row__desc">@doc.Description</p>
                                </div>

                                <div class="resource-document-row__utility">
                                    <span class="resource-document-row__pages">
                                        <svg class="resource-document-row__pages-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                            <polyline points="14 2 14 8 20 8"></polyline>
                                        </svg>
                                        <span class="resource-document-row__pages-text">@(doc.PageCount) @(doc.PageCount == 1 ? "page" : "pages")</span>
                                    </span>
                                    <div class="resource-document-row__actions">
                                        <a href="@doc.DetailUrl"
                                           class="btn btn-secondary btn-sm resource-document-row__action-btn"
                                           aria-label="View document details for @doc.Title">
                                            <span>View Document</span>
                                        </a>
                                        <a href="@doc.LocalPdfPath"
                                           download
                                           class="btn btn-outline btn-sm resource-document-row__download-btn"
                                           aria-label="Download @doc.Title (PDF, @(doc.PageCount) pages)">
                                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                                <polyline points="7 10 12 15 17 10"></polyline>
                                                <line x1="12" y1="15" x2="12" y2="3"></line>
                                            </svg>
                                            <span>Download PDF</span>
                                        </a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>

        <!-- Empty State (No Results) -->
        <div class="resources-empty @(Model.FilteredDocuments.Count > 0 ? "resources-empty--hidden" : "")" id="resources-empty" aria-live="polite">
            <div class="resources-empty__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
            </div>
            <h2 class="resources-empty__title">No matching technical documents</h2>
            <p class="resources-empty__message">No documents matched your current search or category filter. Adjust your search terms, select another product family, or reset all filters.</p>
            <div class="resources-empty__actions">
                <button type="button" id="reset-filters-btn" class="btn btn-secondary">Reset Filters</button>
                <a asp-page="/ContactUs" asp-route-reason="technical-documentation" class="btn btn-primary">Request Technical Information</a>
            </div>
        </div>
    </div>
</section>

<!-- Section 3: Shared Closing CTA -->
<section class="closing-cta closing-cta--default tech-resources-closing-cta" aria-labelledby="closing-cta-heading">
    <div class="container">
        <div class="closing-cta-content">
            <h2 id="closing-cta-heading">Ready to Discuss Your Antenna Requirements?</h2>
            <p>Share your application requirements, product questions, or system needs. USAP can help you evaluate available antenna and related equipment options.</p>
            <div class="closing-cta-actions">
                <a href="/request-a-quote" class="btn btn-primary">Request a Quote</a>
                <a asp-page="/ContactUs" asp-route-reason="technical-documentation" class="btn btn-inverse">Request Technical Information</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/technical-resources.js" asp-append-version="true" defer></script>
}
