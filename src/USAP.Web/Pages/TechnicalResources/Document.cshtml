@page "/technical-resources/document/{slug}"
@model USAP.Web.Pages.TechnicalResources.DocumentModel
@{
    var doc = Model.Document;
}

@section Styles {
    <link rel="stylesheet" href="~/css/technical-resources.css" asp-append-version="true" />
}

<!-- Document Header / Hero -->
<header class="doc-detail-header" aria-labelledby="doc-detail-title">
    <div class="container">
        <div class="doc-detail-header__content">
            <div class="doc-detail-header__meta">
                <span class="eyebrow doc-detail-eyebrow">@doc.FamilyName &middot; @doc.DocumentType</span>
            </div>
            <h1 id="doc-detail-title" class="doc-detail-title">@doc.Title</h1>
            <p class="doc-detail-lead">@doc.Description</p>

            <div class="doc-detail-properties" aria-label="Document specifications">
                <div class="doc-property">
                    <span class="doc-property__label">Product Family:</span>
                    <a href="/products/@doc.FamilySlug" class="doc-property__value doc-property__link">@doc.FamilyName</a>
                </div>
                <div class="doc-property">
                    <span class="doc-property__label">Document Format:</span>
                    <span class="doc-property__value">PDF (@doc.PageCount @(doc.PageCount == 1 ? "Page" : "Pages"))</span>
                </div>
                @if (doc.ModelCodes.Count > 0)
                {
                    <div class="doc-property doc-property--models">
                        <span class="doc-property__label">Covered Models:</span>
                        <div class="doc-property__models-list">
                            @foreach (var modelCode in doc.ModelCodes)
                            {
                                <span class="doc-model-badge">@modelCode</span>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="doc-detail-actions">
                <a href="@doc.LocalPdfPath" class="btn btn-primary" download>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    Download PDF
                </a>
                <a href="@doc.LocalPdfPath" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                    Open PDF in New Tab
                    <span class="sr-only">(opens in new tab)</span>
                </a>
            </div>
        </div>
    </div>
</header>

<!-- Breadcrumb Navigation (Relocated Below Hero) -->
<nav aria-label="Breadcrumb" class="breadcrumbs">
    <div class="container">
        <ol class="breadcrumbs__list">
            <li class="breadcrumbs__item"><a href="/" class="breadcrumbs__link">Home</a></li>
            <li class="breadcrumbs__item"><a href="/technical-resources" class="breadcrumbs__link">Technical Resources</a></li>
            <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">@doc.Title</li>
        </ol>
    </div>
</nav>

<!-- Embedded Viewer Section -->
<section class="doc-viewer-section" aria-label="Document Viewer">
    <div class="container">
        <div class="doc-viewer-card">
            <div class="doc-viewer-card__header">
                <h2 class="doc-viewer-card__title">Document Preview</h2>
            </div>
            <div class="doc-viewer-wrapper">
                <object data="@doc.LocalPdfPath"
                        type="application/pdf"
                        class="doc-pdf-object"
                        title="@doc.Title PDF Viewer">
                    <iframe src="@doc.LocalPdfPath"
                            class="doc-pdf-iframe"
                            title="@doc.Title Embedded PDF">
                        <div class="doc-pdf-fallback">
                            <p>Embedded PDF preview is not available on this browser or device.</p>
                            <a href="@doc.LocalPdfPath" class="btn btn-primary" download>Download @doc.Title (PDF)</a>
                        </div>
                    </iframe>
                </object>
            </div>
            <div class="doc-viewer-card__footer">
                <p class="doc-viewer-card__note">
                    Having trouble viewing the preview above?
                    <a href="@doc.LocalPdfPath" target="_blank" rel="noopener noreferrer">Open PDF in a new tab</a>
                    or
                    <a href="@doc.LocalPdfPath" download>download the file directly</a>.
                </p>
            </div>
        </div>

        @if (Model.RelatedGroups.Count > 0)
        {
            <div class="doc-related-groups">
                <h3 class="doc-related-heading">Related Products &amp; System Groups</h3>
                <div class="doc-related-grid">
                    @foreach (var group in Model.RelatedGroups)
                    {
                        <div class="doc-related-card">
                            <h4 class="doc-related-card__title">@group.Name</h4>
                            @if (!string.IsNullOrWhiteSpace(group.ShortDescription))
                            {
                                <p class="doc-related-card__summary">@group.ShortDescription</p>
                            }
                            <a href="/products/@doc.FamilySlug" class="doc-related-card__link">
                                Explore in @doc.FamilyName &rarr;
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

<!-- Section 3: Shared Closing CTA -->
<section class="closing-cta closing-cta--default tech-resources-closing-cta" aria-labelledby="closing-cta-heading">
    <div class="container">
        <div class="closing-cta-content">
            <h2 id="closing-cta-heading">Ready to Discuss Your Antenna Requirements?</h2>
            <p>Share your application requirements, product questions, or system needs. USAP can help you evaluate available antenna and related equipment options.</p>
            <div class="closing-cta-actions">
                <a href="/request-a-quote" class="btn btn-primary">Request a Quote</a>
                <a href="/contact-us" class="btn btn-inverse">Request Information</a>
            </div>
        </div>
    </div>
</section>
