@page "/technical-resources/document/{slug}"
@model USAP.Web.Pages.TechnicalResources.DocumentModel
@{
    var doc = Model.Document;
}

@section Styles {
    <link rel="stylesheet" href="~/css/technical-resources.css" asp-append-version="true" />
}


<!-- Document Header / Hero & Document Access Region -->
<header class="doc-detail-header" aria-labelledby="doc-detail-title">
    <div class="container">
        <div class="doc-detail-layout">
            <!-- Primary Content Area -->
            <div class="doc-detail-primary">
                <div class="doc-detail-header__meta">
                    <span class="eyebrow doc-detail-eyebrow">@doc.FamilyName &middot; @doc.DocumentType</span>
                </div>
                <h1 id="doc-detail-title" class="doc-detail-title">@doc.Title</h1>
                <p class="doc-detail-lead">@doc.Description</p>
            </div>

            <!-- Document Access Panel -->
            <aside class="doc-access-panel" aria-labelledby="doc-access-title">
                <div class="doc-access-card">
                    <div class="doc-access-card__header">
                        <div class="doc-access-card__badge-group">
                            <span class="doc-access-card__badge doc-access-card__badge--format">PDF</span>
                            <span class="doc-access-card__badge doc-access-card__badge--pages">@doc.PageCount @(doc.PageCount == 1 ? "Page" : "Pages")</span>
                        </div>
                        <span class="doc-access-card__type">@doc.DocumentType</span>
                    </div>

                    <div class="doc-access-card__body">
                        <h2 id="doc-access-title" class="doc-access-card__title">Document Access</h2>
                        <p class="doc-access-card__guidance">
                            Open the original USAP PDF in a new browser tab or download a copy.
                        </p>

                        <div class="doc-access-card__actions">
                            <a href="@doc.LocalPdfPath"
                                class="doc-access-btn doc-access-btn--primary"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Open @doc.Title in a new tab">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                    <polyline points="15 3 21 3 21 9"></polyline>
                                    <line x1="10" y1="14" x2="21" y2="3"></line>
                                </svg>
                                Open PDF
                                <span class="sr-only">(opens in new tab)</span>
                            </a>
                            <a href="@doc.LocalPdfPath"
                                class="doc-access-btn doc-access-btn--secondary"
                                download
                                aria-label="Download @doc.Title PDF">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                                Download PDF
                            </a>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</header>

<!-- Breadcrumb Navigation (Relocated Below Hero) -->
<nav aria-label="Breadcrumb" class="breadcrumbs">
    <div class="container">
        <ol class="breadcrumbs__list">
            <li class="breadcrumbs__item"><a href="/" class="breadcrumbs__link">Home</a></li>
            <li class="breadcrumbs__item"><a href="/technical-resources" class="breadcrumbs__link">Technical Resources</a></li>
            <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">@doc.Title</li>
        </ol>
    </div>
</nav>

<!-- Main Document Body -->
<main class="doc-main-content">
    @if (Model.Enrichment != null)
    {
        <!-- Section 1 & 2: Document Overview & Associated Product Visual -->
        <section class="doc-body-section doc-overview-section" aria-labelledby="doc-overview-heading">
            <div class="container">
                <div class="doc-overview-layout">
                    <div class="doc-overview-main">
                        <h2 id="doc-overview-heading" class="doc-section-heading">Document Overview</h2>
                        <p class="doc-overview-text">@Model.Enrichment.Overview</p>
                    </div>
                    @if (Model.PrimaryVisual != null)
                    {
                        <div class="doc-visual-column">
                            <div class="doc-visual-card">
                                <div class="doc-visual-frame">
                                    <img src="@Model.PrimaryVisual.ImagePath"
                                         alt="@Model.PrimaryVisual.AltText"
                                         loading="lazy"
                                         class="doc-visual-img" />
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.PrimaryGroupTitle))
                                {
                                    <span class="doc-visual-caption">Associated Equipment: @Model.PrimaryGroupTitle</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- Section 3: Document Details -->
        <section class="doc-body-section doc-details-section" aria-labelledby="doc-details-heading">
            <div class="container">
                <h2 id="doc-details-heading" class="doc-section-heading">Document Details</h2>
                <dl class="doc-details-grid">
                    <div class="doc-detail-item">
                        <dt class="doc-detail-term">Product Family</dt>
                        <dd class="doc-detail-desc"><a href="/products/@doc.FamilySlug" class="doc-detail-link">@doc.FamilyName</a></dd>
                    </div>
                    <div class="doc-detail-item">
                        <dt class="doc-detail-term">Document Type</dt>
                        <dd class="doc-detail-desc">@doc.DocumentType</dd>
                    </div>
                    @if (doc.ModelCodes.Count > 0)
                    {
                        <div class="doc-detail-item doc-detail-item--models">
                            <dt class="doc-detail-term">Covered Models</dt>
                            <dd class="doc-detail-desc">
                                <div class="doc-detail-models-list">
                                    @foreach (var modelCode in doc.ModelCodes)
                                    {
                                        <span class="doc-model-badge">@modelCode</span>
                                    }
                                </div>
                            </dd>
                        </div>
                    }
                    <div class="doc-detail-item">
                        <dt class="doc-detail-term">Document Format</dt>
                        <dd class="doc-detail-desc">PDF (@doc.PageCount @(doc.PageCount == 1 ? "Page" : "Pages"))</dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.PrimaryGroupTitle))
                    {
                        <div class="doc-detail-item">
                            <dt class="doc-detail-term">Related System Group</dt>
                            <dd class="doc-detail-desc">@Model.PrimaryGroupTitle</dd>
                        </div>
                    }
                </dl>
            </div>
        </section>

        <!-- Section 4: Inside This Document -->
        <section class="doc-body-section doc-inside-section" aria-labelledby="doc-inside-heading">
            <div class="container">
                <h2 id="doc-inside-heading" class="doc-section-heading">Inside This Document</h2>
                <p class="doc-inside-guidance">Key technical topics and sections detailed in the canonical PDF:</p>
                <ul class="doc-topics-list" role="list">
                    @foreach (var topic in Model.Enrichment.KeyTopics)
                    {
                        <li class="doc-topic-item">
                            <span class="doc-topic-marker" aria-hidden="true">&#9679;</span>
                            <span class="doc-topic-text">@topic</span>
                        </li>
                    }
                </ul>
            </div>
        </section>
    }
    else
    {
        <!-- Standard Document Details for non-enriched pages -->
        <section class="doc-body-section doc-details-section" aria-labelledby="doc-details-heading">
            <div class="container">
                <h2 id="doc-details-heading" class="doc-section-heading">Document Details</h2>
                <dl class="doc-details-grid">
                    <div class="doc-detail-item">
                        <dt class="doc-detail-term">Product Family</dt>
                        <dd class="doc-detail-desc"><a href="/products/@doc.FamilySlug" class="doc-detail-link">@doc.FamilyName</a></dd>
                    </div>
                    <div class="doc-detail-item">
                        <dt class="doc-detail-term">Document Type</dt>
                        <dd class="doc-detail-desc">@doc.DocumentType</dd>
                    </div>
                    @if (doc.ModelCodes.Count > 0)
                    {
                        <div class="doc-detail-item doc-detail-item--models">
                            <dt class="doc-detail-term">Covered Models</dt>
                            <dd class="doc-detail-desc">
                                <div class="doc-detail-models-list">
                                    @foreach (var modelCode in doc.ModelCodes)
                                    {
                                        <span class="doc-model-badge">@modelCode</span>
                                    }
                                </div>
                            </dd>
                        </div>
                    }
                    <div class="doc-detail-item">
                        <dt class="doc-detail-term">Document Format</dt>
                        <dd class="doc-detail-desc">PDF (@doc.PageCount @(doc.PageCount == 1 ? "Page" : "Pages"))</dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.PrimaryGroupTitle))
                    {
                        <div class="doc-detail-item">
                            <dt class="doc-detail-term">Related System Group</dt>
                            <dd class="doc-detail-desc">@Model.PrimaryGroupTitle</dd>
                        </div>
                    }
                </dl>
            </div>
        </section>
    }

    <!-- Section 5: Related Products & System Groups -->
    @if (Model.RelatedGroups.Count > 0)
    {
        <section class="doc-body-section doc-related-section" aria-labelledby="doc-related-heading">
            <div class="container">
                <h2 id="doc-related-heading" class="doc-section-heading">Related Products &amp; System Groups</h2>
                <div class="doc-related-grid @(Model.RelatedGroups.Count == 1 ? "doc-related-grid--single" : "")">
                    @foreach (var group in Model.RelatedGroups)
                    {
                        <div class="doc-related-card">
                            <div class="doc-related-card__content">
                                <h3 class="doc-related-card__title">@group.Name</h3>
                                @if (!string.IsNullOrWhiteSpace(group.ShortDescription))
                                {
                                    <p class="doc-related-card__summary">@group.ShortDescription</p>
                                }
                            </div>
                            <div class="doc-related-card__action">
                                <a href="/products/@doc.FamilySlug#@group.SectionAnchor" class="doc-related-card__link">
                                    Explore in @doc.FamilyName &rarr;
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- Section 6: Shared Closing CTA -->
    <section class="closing-cta closing-cta--default tech-resources-closing-cta" aria-labelledby="closing-cta-heading">
        <div class="container">
            <div class="closing-cta-content">
                <h2 id="closing-cta-heading">Ready to Discuss Your Antenna Requirements?</h2>
                <p>Share your application requirements, product questions, or system needs. USAP can help you evaluate available antenna and related equipment options.</p>
                <div class="closing-cta-actions">
                    <a asp-page="/RequestAQuote" asp-route-doc="@Model.Document.Slug" class="btn btn-primary">Request a Quote</a>
                    <a asp-page="/ContactUs" asp-route-reason="technical-documentation" asp-route-doc="@Model.Document.Slug" class="btn btn-inverse">Ask About This Document</a>
                </div>
            </div>
        </div>
    </section>
</main>
