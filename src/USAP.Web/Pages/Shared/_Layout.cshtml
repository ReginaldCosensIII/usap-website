<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @await Html.PartialAsync("_Seo")
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @await Html.PartialAsync("_StructuredData")
    @await RenderSectionAsync("StructuredData", required: false)
</head>
<body>
    @* Skip link — must be the first focusable element in the document. *@
    <a class="skip-link" href="#main-content">Skip to main content</a>

    @* Shared header with brand, primary navigation, and mobile toggle *@
    @await Html.PartialAsync("_Header")

    @* Main content target — tabindex="-1" allows skip-link focus *@
    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>

    @* Shared footer *@
    @await Html.PartialAsync("_Footer")

    @* Navigation and Disclosure JS — deferred so they do not block rendering. *@
    <script src="~/js/site-navigation.js" asp-append-version="true" defer></script>
    <script src="~/js/disclosure.js" asp-append-version="true" defer></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
