@model USAP.Web.Models.InquiryFormInput
@using USAP.Web.Models
@using USAP.Web.Pages
@using Microsoft.Extensions.Options
@using USAP.Web.Configuration
@inject IOptions<RecaptchaOptions> RecaptchaOptionsAccessor

@{
    var isQuoteWorkflow = (bool?)ViewData["IsQuoteWorkflow"]
        ?? (ViewContext.ActionDescriptor as Microsoft.AspNetCore.Mvc.RazorPages.CompiledPageActionDescriptor)?.HandlerTypeInfo == typeof(RequestAQuoteModel);
    var recaptchaOptions = RecaptchaOptionsAccessor.Value;
    var recaptchaEnabled = recaptchaOptions.Enabled;
    var recaptchaSiteKey = recaptchaOptions.SiteKey;
    var recaptchaAction = (string?)ViewData["RecaptchaAction"] ?? (isQuoteWorkflow ? "quote_request" : "contact_submit");
}

<form method="post" id="inquiryForm" class="inquiry-form stack" data-quote-value="@((int)InquiryType.RequestAQuote)" data-recaptcha-enabled="@(recaptchaEnabled ? "true" : "false")" data-recaptcha-site-key="@recaptchaSiteKey" data-recaptcha-action="@recaptchaAction">

    <div asp-validation-summary="All" class="notice notice-error" role="alert"></div>

    <div id="recaptchaClientError" class="notice notice-error" role="alert" style="display: none;">We couldn't verify your submission. Please try again.</div>

    @if (recaptchaEnabled)
    {
        <noscript>
            <div class="notice notice-warning" role="alert">
                JavaScript is required to submit this form because spam protection is enabled.
            </div>
        </noscript>
    }

    @* Trusted Context Treatment (FORMS-002) *@
    @if (!string.IsNullOrWhiteSpace(Model.SourceContextTitle))
    {
        <aside class="inquiry-context-panel" role="region" aria-label="Originating Context">
            <span class="inquiry-context-panel__label">@(Model.SourceContextCategory ?? "Inquiry Context")</span>
            <strong class="inquiry-context-panel__title">@Model.SourceContextTitle</strong>
        </aside>
    }

    @* Context Identifiers (Re-resolved Server-Side on POST) *@
    <input type="hidden" asp-for="ContextReason" />
    <input type="hidden" asp-for="ContextFamily" />
    <input type="hidden" asp-for="ContextGroup" />
    <input type="hidden" asp-for="ContextDoc" />

    @* Dedicated reCAPTCHA token field *@
    <input type="hidden" name="RecaptchaToken" id="recaptchaToken" value="" />

    @* Accessible Honeypot (FORMS-002) *@
    <div class="form-honeypot" aria-hidden="true">
        <label for="form-website-field">Website</label>
        <input type="text" asp-for="Website" id="form-website-field" tabindex="-1" autocomplete="off" />
    </div>

    <div class="grid grid-2">
        <div class="form-group">
            <label asp-for="Name" class="form-label">Name <span class="form-required" aria-label="required">*</span></label>
            <input asp-for="Name" class="form-control" autocomplete="name" aria-required="true" />
            <span asp-validation-for="Name" class="form-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email" class="form-label">Email Address <span class="form-required" aria-label="required">*</span></label>
            <input asp-for="Email" type="email" class="form-control" autocomplete="email" aria-required="true" />
            <span asp-validation-for="Email" class="form-error"></span>
        </div>

        <div class="form-group">
            @if (isQuoteWorkflow)
            {
                <label asp-for="Organization" class="form-label">Organization/Company <span class="form-required" aria-label="required">*</span></label>
                <input asp-for="Organization" class="form-control" autocomplete="organization" aria-required="true" />
            }
            else
            {
                <label asp-for="Organization" class="form-label">Organization/Company</label>
                <input asp-for="Organization" class="form-control" autocomplete="organization" />
            }
            <span asp-validation-for="Organization" class="form-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Phone" class="form-label">Phone</label>
            <input asp-for="Phone" type="tel" class="form-control" autocomplete="tel" />
            <span asp-validation-for="Phone" class="form-error"></span>
        </div>
    </div>

    <div class="grid grid-2">
        @if (isQuoteWorkflow)
        {
            <div class="form-group">
                <label class="form-label">Inquiry Type</label>
                <div class="form-control form-control--static">Request a Quote</div>
                <input type="hidden" asp-for="Type" value="@InquiryType.RequestAQuote" />
            </div>
        }
        else
        {
            var contactTypes = Html.GetEnumSelectList<InquiryType>()
                .Where(item => item.Value != ((int)InquiryType.RequestAQuote).ToString());

            <div class="form-group">
                <label asp-for="Type" class="form-label">Inquiry Type <span class="form-required" aria-label="required">*</span></label>
                <select asp-for="Type" asp-items="contactTypes" class="form-control js-inquiry-type-select" aria-required="true">
                </select>
                <span asp-validation-for="Type" class="form-error"></span>
            </div>
        }

        <div class="form-group">
            <label asp-for="PreferredContactMethod" class="form-label">Preferred Contact Method</label>
            <select asp-for="PreferredContactMethod" asp-items="Html.GetEnumSelectList<ContactMethod>()" class="form-control">
            </select>
            <span asp-validation-for="PreferredContactMethod" class="form-error"></span>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="ProductOfInterest" class="form-label">Product/Model of Interest</label>
        <input asp-for="ProductOfInterest" class="form-control" />
        <span asp-validation-for="ProductOfInterest" class="form-error"></span>
    </div>

    @if (isQuoteWorkflow)
    {
        <fieldset class="form-group js-conditional-group js-quote-fields stack-sm quote-details-group">
            <legend class="form-label">Quote Details</legend>

            <div class="grid grid-2">
                <div class="form-group">
                    <label asp-for="EstimatedQuantity" class="form-label">Estimated Quantity</label>
                    <input asp-for="EstimatedQuantity" class="form-control" />
                    <span asp-validation-for="EstimatedQuantity" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DesiredTimeline" class="form-label">Desired Timeline</label>
                    <input asp-for="DesiredTimeline" class="form-control" placeholder="e.g., target quarter or ASAP" />
                    <span asp-validation-for="DesiredTimeline" class="form-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="IntendedApplication" class="form-label">Intended Application</label>
                <textarea asp-for="IntendedApplication" class="form-control" rows="3"></textarea>
                <span asp-validation-for="IntendedApplication" class="form-error"></span>
            </div>
        </fieldset>
    }

    <div class="form-group">
        <label asp-for="Message" class="form-label">Message / Project Requirements <span class="form-required" aria-label="required">*</span></label>
        <textarea asp-for="Message" class="form-control" aria-required="true"></textarea>
        <span asp-validation-for="Message" class="form-error"></span>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary btn-lg">Submit Inquiry</button>
    </div>
</form>
