@page "/products"
@model USAP.Web.Pages.Products.IndexModel
@{
    ViewData[USAP.Web.Models.SeoMetadata.ViewDataKey] = new USAP.Web.Models.SeoMetadata
    {
        Title = "Antenna Products & Systems",
        Description = "Explore USAP's six core antenna system families, including log periodic arrays, portable and transportable systems, aperiodic loops, NVIS solutions, rotators, and towers.",
        CanonicalPath = "/products",
        Robots = "index, follow",
        OpenGraphType = "website"
    };
}

<!-- Section 1: Hero / Introductory Banner -->
<section class="internal-hero internal-hero--products" aria-labelledby="products-hero-title">
    <div class="internal-hero-bg" aria-hidden="true"></div>
    <img class="internal-hero-image"
         src="@Model.HeroAsset.ImagePath"
         alt="@Model.HeroAsset.AltText"
         width="2048"
         height="768"
         fetchpriority="high"
         decoding="async" />
    <div class="internal-hero-overlay" aria-hidden="true"></div>
    <div class="container">
        <div class="internal-hero-content">
            <span class="eyebrow internal-hero-eyebrow">Product Catalog</span>
            <h1 id="products-hero-title" class="internal-hero-title">Antenna Products &amp; Systems</h1>
            <p class="internal-hero-lead">Engineered for defense, government, and commercial communications. Explore USAP's structured product families spanning tactical HF, transportable systems, directional receiving loops, NVIS arrays, and antenna positioning systems.</p>
        </div>
    </div>
</section>

<!-- Section 2: Six Product Families Grid -->
<section class="section products-families-section" aria-labelledby="catalog-families-heading">
    <div class="container">
        <div class="section-intro">
            <span class="eyebrow">Catalog Overview</span>
            <h2 id="catalog-families-heading" class="section-heading">Product Families</h2>
            <p class="section-lead">Select an antenna family below to review system configurations, operational characteristics, and available models.</p>
        </div>

        <div class="products-family-grid">
            @foreach (var family in Model.Families)
            {
                <partial name="_ProductFamilyCard" model="family" />
            }
        </div>
    </div>
</section>

<!-- Section 3: Selection Help / Guidance Section -->
<section class="section selection-help-section" aria-labelledby="selection-help-heading">
    <div class="container">
        <div class="section-intro">
            <span class="eyebrow">Engineering Guidance</span>
            <h2 id="selection-help-heading" class="section-heading">Selecting the Right Antenna System</h2>
            <p class="section-lead">USAP provides antenna systems across diverse propagation modes and installation requirements. Consider these key operational criteria when evaluating options for your application.</p>
        </div>

        <div class="selection-help-grid">
            <div class="card card--ambient selection-help-card">
                <div class="selection-help-card__media">
                    <img src="/images/products/engineering-guidance/usap-engineering-guidance-deployment-mobility-source-guided-candidate-a1-v1.png"
                         alt="Portable antenna system with a sectional mast, support lines, and transport context in a field setting."
                         class="selection-help-card__img"
                         width="1600"
                         height="1000"
                         loading="lazy"
                         decoding="async" />
                </div>
                <div class="card-body">
                    <div class="selection-help-card__header">
                        <span class="eyebrow selection-help-card__eyebrow">Deployment &amp; Mobility</span>
                        <div class="selection-help-card__icon" aria-hidden="true">
                            <svg class="selection-help-card__svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2v20M5 22h14M7 7l5-5 5 5M4 12l8-8 8 8" />
                            </svg>
                        </div>
                    </div>
                    <h3 class="selection-help-card__title">Field vs. Fixed Installation</h3>
                    <p class="selection-help-card__text">Evaluate field-deployable masts and transportable antenna packages versus permanent tower-mounted base installations based on deployment speed, transport constraints, and site infrastructure.</p>
                    <div class="selection-help-card__links">
                        <span class="selection-help-card__links-label">Relevant Families:</span>
                        <ul class="selection-help-card__links-list">
                            <li><a href="/products/portable-transportable-antennas">Portable &amp; Transportable</a></li>
                            <li><a href="/products/log-periodic-antennas">Log Periodic Antennas</a></li>
                            <li><a href="/products/tower-systems-accessories">Tower Systems &amp; Accessories</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="card card--ambient selection-help-card">
                <div class="selection-help-card__media">
                    <img src="/images/products/engineering-guidance/usap-engineering-guidance-coverage-propagation-source-guided-candidate-a1-v1.png"
                         alt="Directional, vertical, and low-profile antenna concepts shown with qualitative atmospheric coverage fields."
                         class="selection-help-card__img"
                         width="1600"
                         height="1000"
                         loading="lazy"
                         decoding="async" />
                </div>
                <div class="card-body">
                    <div class="selection-help-card__header">
                        <span class="eyebrow selection-help-card__eyebrow">Coverage &amp; Propagation</span>
                        <div class="selection-help-card__icon" aria-hidden="true">
                            <svg class="selection-help-card__svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 12h4c1.5 0 2-4 4-4s2.5 8 4.5 8 2.5-4 4.5-4h3" />
                            </svg>
                        </div>
                    </div>
                    <h3 class="selection-help-card__title">Directional, Omnidirectional &amp; NVIS</h3>
                    <p class="selection-help-card__text">Select directional log periodics for forward gain over long circuits, omnidirectional configurations for multi-point coverage, or NVIS arrays for regional short- to medium-range communications across challenging terrain.</p>
                    <div class="selection-help-card__links">
                        <span class="selection-help-card__links-label">Relevant Families:</span>
                        <ul class="selection-help-card__links-list">
                            <li><a href="/products/log-periodic-antennas">Log Periodic Antennas</a></li>
                            <li><a href="/products/nvis-antennas">NVIS Antennas</a></li>
                            <li><a href="/products/aperiodic-loop-antennas">Aperiodic Loop Antennas</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="card card--ambient selection-help-card">
                <div class="selection-help-card__media">
                    <img src="/images/products/engineering-guidance/usap-engineering-guidance-positioning-infrastructure-source-guided-candidate-a1-v1.png"
                         alt="Tower, rotator, mounting, support, and feed-path concepts in a generalized engineering setting."
                         class="selection-help-card__img"
                         width="1600"
                         height="1000"
                         loading="lazy"
                         decoding="async" />
                </div>
                <div class="card-body">
                    <div class="selection-help-card__header">
                        <span class="eyebrow selection-help-card__eyebrow">Positioning &amp; Infrastructure</span>
                        <div class="selection-help-card__icon" aria-hidden="true">
                            <svg class="selection-help-card__svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="3" />
                                <path d="M12 2v3m0 14v3M2 12h3m14 0h3m-3.5-6.5-2.1 2.1m-8.8 8.8-2.1 2.1m13 0-2.1-2.1m-8.8-8.8-2.1-2.1" />
                            </svg>
                        </div>
                    </div>
                    <h3 class="selection-help-card__title">Rotation, Control &amp; Support</h3>
                    <p class="selection-help-card__text">Pair directional arrays with heavy-duty rotators, tabletop or industrial controllers, compatible tower sections, and matching mast hardware for complete system reliability.</p>
                    <div class="selection-help-card__links">
                        <span class="selection-help-card__links-label">Relevant Families:</span>
                        <ul class="selection-help-card__links-list">
                            <li><a href="/products/antenna-rotator-control-systems">Rotator &amp; Control Systems</a></li>
                            <li><a href="/products/tower-systems-accessories">Tower Systems &amp; Accessories</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="guidance-continuation">
            <p class="guidance-continuation__text">
                <strong>Not sure which family fits your operational requirements?</strong>
                Review our <a href="#products-faq">Product Selection FAQ</a> below or <a href="#closing-cta-heading">consult with USAP engineering</a> for tailored technical guidance.
            </p>
        </div>
    </div>
</section>

<!-- Section 4: Product Selection FAQ -->
<section class="section faq-section" id="products-faq" aria-labelledby="faq-heading">
    <div class="container">
        <div class="section-intro">
            <span class="eyebrow">Frequently Asked Questions</span>
            <h2 id="faq-heading" class="section-heading">Product Selection FAQ</h2>
            <p class="section-lead">Answers to common engineering questions regarding antenna selection, deployment options, and system integration.</p>
        </div>

        <div class="faq-list">
            <details class="faq-item">
                <summary class="faq-summary">
                    <span class="faq-question">How do I choose between a directional log periodic and an omnidirectional antenna?</span>
                    <span class="faq-icon" aria-hidden="true"></span>
                </summary>
                <div class="faq-content">
                    <p>Directional log periodic antennas provide focused forward gain and front-to-back discrimination across wide frequency bands for point-to-point or sector communications, often paired with an antenna rotator. Omnidirectional antennas provide continuous 360-degree azimuthal coverage without mechanical steering, suitable for multi-party networks, tactical base stations, or broadcast environments communicating with units in multiple directions.</p>
                </div>
            </details>

            <details class="faq-item">
                <summary class="faq-summary">
                    <span class="faq-question">What is NVIS and when should it be considered?</span>
                    <span class="faq-icon" aria-hidden="true"></span>
                </summary>
                <div class="faq-content">
                    <p>Near Vertical Incidence Skywave (NVIS) antenna configurations radiate RF energy at high elevation angles to reflect off the ionosphere, supporting regional HF communications across terrain that obstructs line-of-sight propagation. Coverage profiles and frequency selection depend on operating frequency, time of day, and ionospheric conditions.</p>
                </div>
            </details>

            <details class="faq-item">
                <summary class="faq-summary">
                    <span class="faq-question">Are USAP portable antenna systems suitable for rapid field deployment?</span>
                    <span class="faq-icon" aria-hidden="true"></span>
                </summary>
                <div class="faq-content">
                    <p>USAP transportable and portable antenna configurations are designed for field deployment with tactical masts, guy hardware, and compact transit packaging. Specific setup requirements, assembly procedures, and wind survival ratings vary by model&mdash;consult USAP engineering for application planning.</p>
                </div>
            </details>

            <details class="faq-item">
                <summary class="faq-summary">
                    <span class="faq-question">Can USAP antenna rotators and controllers integrate with existing mast or tower hardware?</span>
                    <span class="faq-icon" aria-hidden="true"></span>
                </summary>
                <div class="faq-content">
                    <p>USAP mechanical rotators and companion controllers (including the R3500 series and DRC-3/DRC-4) are designed for installation on compatible towers and mast structures. Because mounting dimensions, torque requirements, feedline routing, and control cabling depend on the specific antenna and structure, installation parameters should be confirmed with USAP engineering.</p>
                </div>
            </details>

            <details class="faq-item">
                <summary class="faq-summary">
                    <span class="faq-question">Does USAP provide customized antenna designs or frequency coverage?</span>
                    <span class="faq-icon" aria-hidden="true"></span>
                </summary>
                <div class="faq-content">
                    <p>USAP engineering evaluates application requirements for commercial, industrial, and government projects. Inquiries regarding specialized frequency coverage, modified configurations, or integrated rotator and support hardware should be directed to USAP engineering.</p>
                </div>
            </details>

            <details class="faq-item">
                <summary class="faq-summary">
                    <span class="faq-question">How do I request technical specifications or formal pricing?</span>
                    <span class="faq-icon" aria-hidden="true"></span>
                </summary>
                <div class="faq-content">
                    <p>You can submit a quotation request through our online <a href="/request-a-quote">Request a Quote</a> form or contact our engineering team directly via <a asp-page="/ContactUs" asp-route-reason="engineering-support">Contact Engineering</a> with your operational parameters, frequency ranges, and mounting requirements.</p>
                </div>
            </details>
        </div>
    </div>
</section>

<!-- Section 5: Shared Closing CTA -->
<section class="closing-cta closing-cta--default products-closing-cta" aria-labelledby="closing-cta-heading">
    <div class="container">
        <div class="closing-cta-content">
            <span class="eyebrow">System Consultation</span>
            <h2 id="closing-cta-heading">Ready to Discuss Your Antenna Requirements?</h2>
            <p>Share your application requirements, frequency coverage needs, or deployment constraints. USAP engineering can help you evaluate available antenna and positioning options.</p>
            <div class="closing-cta-actions">
                <a href="/request-a-quote" class="btn btn-primary">Request a Quote</a>
                <a asp-page="/ContactUs" asp-route-reason="engineering-support" class="btn btn-inverse">Contact Engineering</a>
            </div>
        </div>
    </div>
</section>
