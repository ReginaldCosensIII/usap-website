@page "/request-a-quote"
@model USAP.Web.Pages.RequestAQuoteModel
@{
    ViewData[USAP.Web.Models.SeoMetadata.ViewDataKey] = new USAP.Web.Models.SeoMetadata
    {
        Title = "Request a Quote",
        Description = "Request information or a quote for antenna systems, rotators, controls, and engineering support from United States Antenna Products.",
        CanonicalPath = "/request-a-quote",
        Robots = "index, follow",
        OpenGraphType = "website"
    };
}

<div class="container section">
    <h1>Request a Quote</h1>
    <p>Provide the available product, quantity, application, and timeline details for your request.</p>

    <div class="card mt-8">
        <div class="card-body">
            <partial name="_InquiryForm" for="Input" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/inquiry-form.js" asp-append-version="true" defer></script>
}
