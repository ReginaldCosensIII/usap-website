@page "/request-a-quote"
@model USAP.Web.Pages.RequestAQuoteModel
@{
    ViewData[USAP.Web.Models.SeoMetadata.ViewDataKey] = new USAP.Web.Models.SeoMetadata
    {
        Title = "Request a Quote",
        Description = "Request information or a quote for antenna systems, rotators, controls, and engineering support from United States Antenna Products.",
        CanonicalPath = "/request-a-quote",
        Robots = "index, follow",
        OpenGraphType = "website"
    };
}

<!-- Section 1: Hero / Introductory Banner -->
<section class="internal-hero internal-hero--quote" aria-labelledby="quote-hero-title">
    <div class="internal-hero-bg" aria-hidden="true"></div>
    <img class="internal-hero-image"
         src="~/images/request-a-quote/usap-quote-hero-technical-planning-candidate-a-v1.png"
         alt=""
         width="2048"
         height="768"
         fetchpriority="high"
         decoding="async" />
    <div class="internal-hero-overlay" aria-hidden="true"></div>
    <div class="container">
        <div class="internal-hero-content">
            <span class="eyebrow internal-hero-eyebrow">Request a Quote</span>
            <h1 id="quote-hero-title" class="internal-hero-title">Request a Quote for Your Antenna System</h1>
            <p class="internal-hero-lead">Share your application and system requirements so USAP can evaluate the request and follow up with an appropriate direction.</p>
        </div>
    </div>
</section>

<!-- Section 2: Form & Sidebar -->
<div class="container section">
    <div class="form-page-layout">
        <div class="form-page-main">
            <div class="card">
                <div class="card-body">
                    <partial name="_InquiryForm" for="Input" />
                </div>
            </div>
        </div>

        <partial name="_ContactSidebar" />
    </div>
</div>

@inject Microsoft.Extensions.Options.IOptions<USAP.Web.Configuration.RecaptchaOptions> RecaptchaOptionsAccessor
@section Scripts {
    @if (RecaptchaOptionsAccessor.Value.Enabled && !string.IsNullOrWhiteSpace(RecaptchaOptionsAccessor.Value.SiteKey))
    {
        <script src="https://www.google.com/recaptcha/enterprise.js?render=@RecaptchaOptionsAccessor.Value.SiteKey" async defer></script>
    }
    <script src="~/js/inquiry-form.js" asp-append-version="true" defer></script>
}
