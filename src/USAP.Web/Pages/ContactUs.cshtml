@page "/contact-us"
@model USAP.Web.Pages.ContactUsModel
@{
    ViewData[USAP.Web.Models.SeoMetadata.ViewDataKey] = new USAP.Web.Models.SeoMetadata
    {
        Title = "Contact Us",
        Description = "Contact United States Antenna Products with questions about antenna systems, technical resources, or general information.",
        CanonicalPath = "/contact-us",
        Robots = "index, follow",
        OpenGraphType = "website"
    };
}

<!-- Section 1: Hero / Introductory Banner -->
<section class="internal-hero internal-hero--contact" aria-labelledby="contact-hero-title">
    <div class="internal-hero-bg" aria-hidden="true"></div>
    <img class="internal-hero-image"
         src="~/images/contact-us/usap-contact-hero-communication-signal-candidate-c-v1.png"
         alt=""
         width="2048"
         height="768"
         fetchpriority="high"
         decoding="async" />
    <div class="internal-hero-overlay" aria-hidden="true"></div>
    <div class="container">
        <div class="internal-hero-content">
            <span class="eyebrow internal-hero-eyebrow">Contact USAP</span>
            <h1 id="contact-hero-title" class="internal-hero-title">Contact United States Antenna Products</h1>
            <p class="internal-hero-lead">Connect with USAP about antenna products, technical support, or general questions.</p>
        </div>
    </div>
</section>

<!-- Section 2: Form & Sidebar -->
<div class="container section">
    <div class="form-page-layout">
        <div class="form-page-main">
            <div class="card">
                <div class="card-body">
                    <partial name="_InquiryForm" for="Input" />
                </div>
            </div>
        </div>

        <partial name="_ContactSidebar" />
    </div>
</div>

@section Scripts {
    <script src="~/js/inquiry-form.js" asp-append-version="true" defer></script>
}
