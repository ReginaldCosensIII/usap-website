@page "/contact-us"
@model USAP.Web.Pages.ContactUsModel
@{
    ViewData[USAP.Web.Models.SeoMetadata.ViewDataKey] = new USAP.Web.Models.SeoMetadata
    {
        Title = "Contact Us",
        Description = "Contact United States Antenna Products with questions about antenna systems, technical resources, or general information.",
        CanonicalPath = "/contact-us",
        Robots = "index, follow",
        OpenGraphType = "website"
    };
}

<div class="container section">
    <h1>Contact Us</h1>
    <p>Tell us what you need, and provide any available product or project details.</p>

    <div class="card mt-8">
        <div class="card-body">
            <partial name="_InquiryForm" for="Input" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/inquiry-form.js" asp-append-version="true" defer></script>
}
