@page "/thank-you"
@model USAP.Web.Pages.ThankYouModel
@{
    ViewData[USAP.Web.Models.SeoMetadata.ViewDataKey] = new USAP.Web.Models.SeoMetadata
    {
        Title = "Thank You",
        Description = "Your request has been received by United States Antenna Products.",
        CanonicalPath = "/thank-you",
        Robots = "noindex, nofollow",
        OpenGraphType = "website"
    };
}

<div class="container section">
    <h1>Thank You</h1>
    <p>@(string.IsNullOrEmpty(Model.ConfirmationMessage) ? "Your inquiry has been successfully submitted." : Model.ConfirmationMessage)</p>

    @if (!string.IsNullOrEmpty(Model.ReferenceNumber))
    {
        <div class="notice notice-success" style="margin-top: 2rem;">
            <p><strong>Reference Number:</strong> @Model.ReferenceNumber</p>
        </div>
    }

    <div style="margin-top: 2rem;">
        <a href="/" class="btn btn-outline">Return to Homepage</a>
    </div>
</div>
