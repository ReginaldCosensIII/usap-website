@page "/about-us"
@model USAP.Web.Pages.AboutUsModel
@{
    ViewData[USAP.Web.Models.SeoMetadata.ViewDataKey] = new USAP.Web.Models.SeoMetadata
    {
        Title = "About Us",
        Description = "Learn about United States Antenna Products, its fifty-year history, Frederick, Maryland manufacturing, and complete antenna engineering support.",
        CanonicalPath = "/about-us",
        Robots = "index, follow",
        OpenGraphType = "website"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/about-us.css" asp-append-version="true" />
}

<!-- Section 1: Hero / Introductory Banner (Preserved) -->
<section class="about-hero" aria-labelledby="about-hero-title">
    <div class="about-hero-bg" aria-hidden="true"></div>
    <div class="about-hero-media" aria-hidden="true">
        <img class="about-hero-image"
             src="~/images/about/usap-about-hero-provisional-v1.png"
             alt=""
             width="1376"
             height="768"
             fetchpriority="high"
             decoding="async" />
    </div>
    <div class="about-hero-overlay" aria-hidden="true"></div>
    <div class="container">
        <div class="about-hero-content">
            <span class="eyebrow about-hero-eyebrow">About USAP</span>
            <h1 id="about-hero-title" class="about-hero-title">Antenna Systems Built for Long-Term Service</h1>
            <p class="about-hero-lead">United States Antenna Products, LLC brings a fifty-year history of antenna performance to military, government, and commercial applications.</p>
            <div class="about-hero-actions">
                <a href="/products" class="btn btn-primary">Explore Products</a>
                <a href="/contact-us" class="btn btn-inverse">Contact USAP</a>
            </div>
        </div>
    </div>
</section>

<!-- Section 2: Company Overview (Restored Asymmetric Composition & Refined Heritage Feature) -->
<section class="section about-overview-section" aria-labelledby="about-overview-heading">
    <div class="container">
        <div class="about-overview-grid">
            <div class="about-overview-header">
                <span class="eyebrow">Company Overview</span>
                <h2 id="about-overview-heading" class="section-heading">Five Decades of Antenna Experience</h2>
            </div>

            <div class="about-overview-feature">
                <div class="about-heritage-card" aria-label="A 50-Year History of Antenna Performance and Core Antenna Capabilities">
                    <!-- Decorative background watermark 50 -->
                    <div class="about-heritage-watermark" aria-hidden="true">50</div>

                    <div class="about-heritage-content">
                        <div class="about-heritage-header">
                            <span class="about-heritage-label">A 50-Year History</span>
                            <h3 class="about-heritage-heading">Antenna Performance</h3>
                        </div>

                        <div class="about-heritage-capabilities">
                            <span class="about-capabilities-heading">Core Antenna Capabilities</span>
                            <ul class="about-capabilities-list" role="list">
                                <li class="about-capability-item">
                                    <span class="about-capability-indicator" aria-hidden="true"></span>
                                    <span class="about-capability-text">Rotating Log-Periodic Antennas</span>
                                </li>
                                <li class="about-capability-item">
                                    <span class="about-capability-indicator" aria-hidden="true"></span>
                                    <span class="about-capability-text">Rooftop NVIS Antennas</span>
                                </li>
                                <li class="about-capability-item">
                                    <span class="about-capability-indicator" aria-hidden="true"></span>
                                    <span class="about-capability-text">High-Sensitivity Receive-Loop Systems</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="about-overview-body stack">
                <p class="about-overview-lead">
                    United States Antenna Products, LLC brings a fifty-year history of antenna performance to military, government, and commercial applications.
                </p>
                <p>
                    The company’s published product range includes rotating log-periodic antennas, rooftop NVIS antennas, and high-sensitivity receive-loop systems. USAP products are designed and manufactured for long-term, rugged service.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Section 3: Manufacturing & Testing (Restored Asymmetrical Header + Unified Feature Cards) -->
<section class="section about-facility-section" aria-labelledby="about-facility-heading">
    <div class="container">
        <div class="about-section-intro-grid">
            <div class="about-section-intro-header">
                <span class="eyebrow">Manufacturing &amp; Testing</span>
                <h2 id="about-facility-heading" class="section-heading">Designed and Manufactured in Frederick, Maryland</h2>
            </div>

            <div class="about-intro-media">
                <img class="about-intro-image"
                     src="~/images/about/usap-about-manufacturing-testing-provisional-v1.jpg"
                     alt="Conceptual view of antenna components and technical equipment."
                     width="1264"
                     height="848"
                     loading="lazy"
                     decoding="async" />
            </div>

            <div class="about-section-intro-body">
                <p class="about-facility-lead">
                    USAP’s manufacturing and test facilities are located in Frederick, Maryland. The company designs and manufactures antenna products for long-term, rugged service.
                </p>
            </div>
        </div>

        <div class="about-facility-cards">
            <div class="about-feature-card">
                <span class="about-card-eyebrow">Facility</span>
                <h3 class="about-card-title">Frederick, Maryland</h3>
                <p class="about-card-text">USAP’s manufacturing and test facilities are located in Frederick, Maryland.</p>
            </div>

            <div class="about-feature-card">
                <span class="about-card-eyebrow">Durability</span>
                <h3 class="about-card-title">Long-Term Service</h3>
                <p class="about-card-text">USAP products are designed and manufactured for long-term, rugged service.</p>
            </div>

            <div class="about-feature-card">
                <span class="about-card-eyebrow">Engineering</span>
                <h3 class="about-card-title">Engineering Support</h3>
                <p class="about-card-text">USAP provides engineering support to assist customers with communication requirements.</p>
            </div>
        </div>
    </div>
</section>

<!-- Section 4: Integrated Support (Restored Asymmetrical Header + Unified Numbered Cards) -->
<section class="section about-support-section" aria-labelledby="about-support-heading">
    <div class="container">
        <div class="about-section-intro-grid">
            <div class="about-section-intro-header">
                <span class="eyebrow">Integrated Support</span>
                <h2 id="about-support-heading" class="section-heading">From Requirements to Complete Systems</h2>
            </div>

            <div class="about-intro-media">
                <img class="about-intro-image"
                     src="~/images/about/usap-about-integrated-support-provisional-v1.jpg"
                     alt="Conceptual view of an installed directional antenna system."
                     width="1264"
                     height="848"
                     loading="lazy"
                     decoding="async" />
            </div>

            <div class="about-section-intro-body">
                <p class="about-support-lead">
                    USAP provides integrated services that include evaluating customer needs, building systems, designing installations, and performing installations.
                </p>
            </div>
        </div>

        <div class="about-support-grid">
            <div class="about-feature-card about-feature-card--numbered">
                <span class="about-card-number" aria-hidden="true">01</span>
                <h3 class="about-card-title">Evaluate Requirements</h3>
                <p class="about-card-text">USAP works with customers to evaluate antenna and communication requirements.</p>
            </div>

            <div class="about-feature-card about-feature-card--numbered">
                <span class="about-card-number" aria-hidden="true">02</span>
                <h3 class="about-card-title">Build Systems</h3>
                <p class="about-card-text">USAP builds antenna systems based on customer needs.</p>
            </div>

            <div class="about-feature-card about-feature-card--numbered">
                <span class="about-card-number" aria-hidden="true">03</span>
                <h3 class="about-card-title">Design Installations</h3>
                <p class="about-card-text">USAP can design complete system installations.</p>
            </div>

            <div class="about-feature-card about-feature-card--numbered">
                <span class="about-card-number" aria-hidden="true">04</span>
                <h3 class="about-card-title">Perform Installations</h3>
                <p class="about-card-text">USAP can perform system installations and provide personalized customer support.</p>
            </div>
        </div>
    </div>
</section>

<!-- Section 5: Products Bridge -->
<section class="section-sm about-products-bridge" aria-labelledby="about-products-heading">
    <div class="container">
        <div class="about-bridge-panel">
            <div class="about-bridge-content">
                <span class="eyebrow">Product Catalog</span>
                <h2 id="about-products-heading">Explore USAP Antenna Products and Systems</h2>
                <p>Browse the current USAP product categories and available model information for antenna systems, controllers, rotators, and related equipment.</p>
            </div>
            <div class="about-bridge-action">
                <a href="/products" class="btn btn-primary">View Products</a>
            </div>
        </div>
    </div>
</section>

<!-- Section 6: Internal Closing CTA (Preserved) -->
<section class="section about-closing-cta" aria-labelledby="about-cta-heading">
    <div class="container">
        <div class="about-closing-cta-card">
            <span class="eyebrow about-closing-eyebrow">Contact Our Team</span>
            <h2 id="about-cta-heading" class="about-closing-title">Discuss Your Antenna Requirements</h2>
            <p class="about-closing-lead">USAP offers engineering support to help customers evaluate communication requirements and identify an appropriate antenna-system direction.</p>
            <div class="about-closing-actions">
                <a href="/request-a-quote" class="btn btn-primary">Request a Quote</a>
                <a href="/contact-us" class="btn btn-inverse">Contact Us</a>
            </div>
        </div>
    </div>
</section>
