@page
@model ErrorModel
@{
    ViewData[USAP.Web.Models.SeoMetadata.ViewDataKey] = new USAP.Web.Models.SeoMetadata
    {
        Title = "Error",
        Description = "The requested page could not be completed.",
        CanonicalPath = "/Error",
        Robots = "noindex, nofollow",
        OpenGraphType = "website"
    };
}

@* Provisional error page — custom error handling deferred to Core Site Build task. *@
<div class="container section">
    <h1>An error occurred</h1>

    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }

    <p>If this problem persists, please <a asp-page="/ContactUs">contact us</a>.</p>
</div>
